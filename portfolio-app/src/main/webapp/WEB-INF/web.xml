<?xml version='1.0' encoding='UTF-8'?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>Portfolio</display-name>
  <listener>
    <listener-class>dev.portfolio.config.Bootstrap</listener-class>
  </listener>
  <filter>
    <filter-name>headers</filter-name>
    <filter-class>dev.portfolio.control.SecurityHeaders</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>headers</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>api</servlet-name>
    <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
    <init-param>
      <param-name>javax.ws.rs.Application</param-name>
      <param-value>dev.portfolio.control.ApiConfiguration</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>api</servlet-name>
    <url-pattern>/api/*</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>dashboard</servlet-name>
    <servlet-class>dev.portfolio.control.DashboardController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>dashboard</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>dashboard</welcome-file>
  </welcome-file-list>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>read</web-resource-name>
      <url-pattern>/api/*</url-pattern>
      <url-pattern>/dashboard</url-pattern>
      <http-method>GET</http-method>
      <http-method>HEAD</http-method>
    </web-resource-collection>
    <auth-constraint>
      <role-name>viewer</role-name>
      <role-name>editor</role-name>
    </auth-constraint>
  </security-constraint>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>write</web-resource-name>
      <url-pattern>/api/*</url-pattern>
      <http-method>POST</http-method>
      <http-method>PUT</http-method>
      <http-method>PATCH</http-method>
      <http-method>DELETE</http-method>
    </web-resource-collection>
    <auth-constraint>
      <role-name>editor</role-name>
    </auth-constraint>
  </security-constraint>
  <login-config>
    <auth-method>BASIC</auth-method>
    <realm-name>portfolio</realm-name>
  </login-config>
  <security-role>
    <role-name>viewer</role-name>
  </security-role>
  <security-role>
    <role-name>editor</role-name>
  </security-role>
  <deny-uncovered-http-methods/>
  <error-page>
    <error-code>500</error-code>
    <location>/error.html</location>
  </error-page>
</web-app>
